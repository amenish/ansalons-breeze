pkgname=sddm-theme-ansalon
pkgver=1.0
pkgrel=1
pkgdesc="Tema SDDM Ansalon basado en Breeze"
arch=(any)
license=(LGPL-2.0-or-later)
depends=(sddm plasma-desktop qt6-5compat)
optdepends=('breeze: tema de cursor breeze_cursors')
source=("ansalon-sddm-$pkgver.tar.gz" ansalon.conf)
sha256sums=(SKIP SKIP)

package() {
  install -d "$pkgdir/usr/share/sddm/themes"
  cp -r ansalon "$pkgdir/usr/share/sddm/themes/"
  install -Dm644 ansalon.conf "$pkgdir/usr/lib/sddm/sddm.conf.d/ansalon.conf"
}
